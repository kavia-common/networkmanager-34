{"is_source_file": true, "format": "Shell script", "description": "This script manages router discovery processes on a given network interface, especially during DHCP v4 address change events. It reads device properties, identifies existing router discovery processes for a specified interface, terminates them if running, and initiates a new router discovery process.", "external_files": ["/etc/device.properties", "/opt/logs/routerInfo.log", "systemctl"], "external_methods": ["pgrep", "kill", "date", "systemctl"], "published": [], "classes": [], "methods": [], "calls": ["pgrep -f \"routerDiscovery $ifc\"", "kill -15 \"$pid\"", "systemctl start routerDiscovery@$ifc"], "search-terms": ["routerDiscovery", "dhcp4-change", "interface", "network management", "bash script", "upnp"], "state": 2, "file_id": 4, "knowledge_revision": 109, "git_revision": "783094af44fc38ca55d41914acddfb9614d67800", "hash": "0316f80ecb31ed8ff99b6db065bdfc95", "format-version": 4, "code-base-name": "networkmanager-34", "filename": "tools/upnp/scripts/getRouterInfo-NMdispatcher.sh", "revision_history": [{"109": "783094af44fc38ca55d41914acddfb9614d67800"}]}